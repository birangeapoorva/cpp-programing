#include <iostream>
using namespace std;

class Employee
{
    int empID;
    string name;
    float salary;

public:
    // Default Constructor
    Employee()
    {
        empID = 0;
        name = "Unknown";
        salary = 0;
    }

    // Parameterized Constructor
    Employee(int id, string n, float s)
    {
        empID = id;
        name = n;
        salary = s;
    }

    // Copy Constructor
    Employee(const Employee &e)
    {
        empID = e.empID;
        name = e.name;
        salary = e.salary;
    }

    void display()
    {
        cout << "Employee ID: " << empID << endl;
        cout << "Name: " << name << endl;
        cout << "Salary: " << salary << endl;
    }
};

int main()
{
    Employee e1;
    Employee e2(101, "APOORVA", 50000);
    Employee e3(e2);

    cout << "Default Constructor:" << endl;
    e1.display();

    cout << "\nParameterized Constructor:" << endl;
    e2.display();

    cout << "\nCopy Constructor:" << endl;
    e3.display();

    return 0;
}
