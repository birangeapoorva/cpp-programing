#include <iostream>
#include <stdexcept>
using namespace std;

int main()
{
    int num;

    cout << "Enter a number: ";
    cin >> num;

    try
    {
        if (num < 0)
        {
            throw runtime_error("Negative number is not allowed");
        }

        cout << "Number is: " << num << endl;
    }
    catch (runtime_error &e)
    {
        cout << "Exception: " << e.what() << endl;
    }

    return 0;
}
